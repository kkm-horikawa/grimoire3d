{
  "name": "grimoire3d",
  "version": "0.4.0",
  "description": "3D magical book documentation generator - Transform your docs into an interactive grimoire",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./styles.css": "./dist/grimoire3d.css"
  },
  "files": [
    "dist",
    "cli"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist && vite build --config vite.site.config.ts",
    "preview": "vite preview",
    "lint": "biome lint src cli",
    "lint:fix": "biome lint --write src cli",
    "format": "biome format --write src cli",
    "format:check": "biome format src cli",
    "check": "biome check src cli",
    "check:fix": "biome check --write src cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "keywords": [
    "documentation",
    "docs",
    "static-site-generator",
    "markdown",
    "mermaid",
    "page-flip",
    "book",
    "react",
    "3d",
    "grimoire",
    "webgl"
  ],
  "author": "kkm-horikawa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkm-horikawa/grimoire3d.git"
  },
  "bugs": {
    "url": "https://github.com/kkm-horikawa/grimoire3d/issues"
  },
  "homepage": "https://github.com/kkm-horikawa/grimoire3d#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dompurify": "3.4.18",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.1",
    "lucide-react": "^1.76.0",
    "mermaid": "12.3.0",
    "mime-types": "^3.0.2",
    "parse5": "^8.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-definition-list": "^2.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "three": "^0.187.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "preact": "11.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write"
    ]
  },
  "bin": {
    "grimoire3d": "./cli/cli.js",
    "grimo": "./cli/cli.js"
  }
}
